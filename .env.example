# Copy this file to `.env` (gitignored) for local development.
#
# Expo inlines only EXPO_PUBLIC_*-prefixed vars into the bundle. Neither value
# here is a secret: the Gemini API key lives only in the Cloudflare Worker (see
# the web repo's worker/), never in this app. The proxy URL below is already
# public -- it ships inside the APK and is declared in eas.json.
#
# Cloud builds (eas build) do NOT read this file; they use the `env` block of
# the matching profile in eas.json. This file is only for local `expo start`.

EXPO_PUBLIC_AI_PROXY_URL=https://nba-gm-ai-proxy.thiagonx.workers.dev

# Optional light abuse gate. Must match the APP_TOKEN secret set on the Worker.
# Obfuscation only -- the token ships in the client bundle, so it deters casual
# abuse but is not real auth.
# EXPO_PUBLIC_AI_PROXY_TOKEN=optional-shared-secret
